# ---------------------------------------------------
# 1. Base setup
# ---------------------------------------------------
FROM node:20-alpine AS base
RUN npm install -g pnpm@9
WORKDIR /app

# ---------------------------------------------------
# 2. Prune the workspace
# ---------------------------------------------------
FROM base AS builder
RUN npm install -g turbo
RUN echo "Rebuild timestamp: $(date +%s)" > /tmp/cache_breaker
COPY . .
RUN turbo prune excelidraw-frontend --docker

# ---------------------------------------------------
# 3. Install dependencies AND inject production env
# ---------------------------------------------------
FROM base AS installer

# # 🔥🔥🔥 CRITICAL FIX — put env here (before build) 🔥🔥🔥
# ENV NEXT_PUBLIC_HTTP_BACKEND_HOST="https://excelidraw-http.onrender.com"
# ENV NEXT_PUBLIC_WS_BACKEND_HOST="wss://excelidraw-ws.onrender.com"

COPY --from=builder /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=builder /app/out/full/ .

# ---------------------------------------------------
# 4. Build Next.js app (NOW ENV is available!)
# ---------------------------------------------------
FROM base AS builder-next
COPY --from=installer /app .
RUN pnpm turbo build --filter=excelidraw-frontend...

# ---------------------------------------------------
# 5. Runner
# ---------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs
USER nextjs

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder-next --chown=nextjs:nodejs \
    /app/apps/excelidraw-frontend/.next/standalone \
    ./

COPY --from=builder-next --chown=nextjs:nodejs \
    /app/apps/excelidraw-frontend/.next/static \
    ./apps/excelidraw-frontend/.next/static

COPY --from=builder-next --chown=nextjs:nodejs \
    /app/apps/excelidraw-frontend/public \
    ./apps/excelidraw-frontend/public

EXPOSE 3000

CMD ["node", "apps/excelidraw-frontend/server.js"]

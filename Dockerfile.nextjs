# ---------------------------------------------------
# 1. Base setup
# ---------------------------------------------------
FROM node:20-alpine AS base

# Install PNPM manually (NO Corepack!)
RUN npm install -g pnpm@9

WORKDIR /app

# ---------------------------------------------------
# 2. Prune the workspace (Turborepo)
# ---------------------------------------------------
FROM base AS builder

# Install Turbo globally
RUN npm install -g turbo

# Break cache for fresh COPY
RUN echo "Rebuild timestamp: $(date +%s)" > /tmp/cache_breaker

# Copy all repo files
COPY . .

# Prune the workspace for the Next.js frontend
RUN turbo prune excelidraw-frontend --docker

# ---------------------------------------------------
# 3. Install dependencies
# ---------------------------------------------------
FROM base AS installer

COPY --from=builder /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=builder /app/out/full/ .

# ---------------------------------------------------
# 4. Build Next.js app
# ---------------------------------------------------
FROM base AS builder-next

COPY --from=installer /app .
RUN pnpm turbo build --filter=excelidraw-frontend...

# ---------------------------------------------------
# 5. Minimal Production Image (The "Runner" Stage)
# ---------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs
USER nextjs

ENV NODE_ENV=production
ENV PORT=3000

# 1. Copy the standalone folder into /app
# This creates /app/node_modules and /app/apps/excelidraw-frontend/...
COPY --from=builder-next --chown=nextjs:nodejs \
    /app/apps/excelidraw-frontend/.next/standalone \
    ./

# 2. Copy static files to the NESTED location
# Next.js expects them at: /app/apps/excelidraw-frontend/.next/static
COPY --from=builder-next --chown=nextjs:nodejs \
    /app/apps/excelidraw-frontend/.next/static \
    ./apps/excelidraw-frontend/.next/static

# 3. Copy public assets to the NESTED location
# Next.js expects them at: /app/apps/excelidraw-frontend/public
COPY --from=builder-next --chown=nextjs:nodejs \
    /app/apps/excelidraw-frontend/public \
    ./apps/excelidraw-frontend/public

EXPOSE 3000

# 4. Point CMD to the nested server.js
CMD ["node", "apps/excelidraw-frontend/server.js"]
